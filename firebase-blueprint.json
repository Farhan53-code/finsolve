{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "PasswordEntry": {
      "title": "PasswordEntry",
      "description": "Password manager entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "Budget": {
      "title": "Budget",
      "description": "Budget plan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "DocumentReminder": {
      "title": "DocumentReminder",
      "description": "Document reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "System notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/passwords/{passwordId}": {
      "schema": "PasswordEntry",
      "description": "Stored password entries"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Budget plans"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expense records"
    },
    "/documents/{documentId}": {
      "schema": "DocumentReminder",
      "description": "Documents and expiry reminders"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit activity logs"
    },
    "/notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "System notifications"
    }
  }
}
